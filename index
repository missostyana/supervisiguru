        function initDashboardCharts(db) {
            // Trend Chart
            const ctxTrend = document.getElementById('chart-trend')?.getContext('2d');
            if (ctxTrend) {
                new Chart(ctxTrend, {
                    type: 'line',
                    data: {
                        labels: db.supervisions.map(s => s.date),
                        datasets: [{
                            label: 'Nilai Akhir',
                            data: db.supervisions.map(s => s.finalGrade),
                            borderColor: '#0284c7',
                            backgroundColor: 'rgba(2, 132, 199, 0.1)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { min: 0, max: 100 } }
                    }
                });
            }

            // Distribution Chart
            const ctxDist = document.getElementById('chart-distribution')?.getContext('2d');
            if (ctxDist) {
                const categories = { 'Amat Baik': 0, 'Baik': 0, 'Kurang': 0 };
                db.supervisions.forEach(s => {
                    if (categories[s.category] !== undefined) categories[s.category]++;
                });

                new Chart(ctxDist, {
                    type: 'doughnut',
                    data: {
                        labels: ['Amat Baik (86-100)', 'Baik (70-85)', 'Kurang (<70)'],
                        datasets: [{
                            data: [categories['Amat Baik'], categories['Baik'], categories['Kurang']],
                            backgroundColor: ['#10b981', '#3b82f6', '#f59e0b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
