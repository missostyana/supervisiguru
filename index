                        </button>
                    </div>
                </div>
            `;

            lucide.createIcons();
            scrollChatToBottom();
        }

        function sendQuickPrompt(promptText) {
            document.getElementById('chat-input-text').value = promptText;
            sendChatMessage();
        }

        async function sendChatMessage() {
            const inputEl = document.getElementById('chat-input-text');
            const text = inputEl.value.trim();
            if(!text) return;

            chatMessages.push({ role: 'user', text: text });
            inputEl.value = '';
            renderAIAssistant(document.getElementById('content-area'));

            // Call Gemini API
            const db = getDB();
            const systemPrompt = `Anda adalah AI Asisten Supervisi Guru profesional. Tugas Anda membantu supervisor menganalisis data supervisi, menyusun rekomendasi tindak lanjut, dan mengevaluasi indikator pembelajaran mendalam. Data supervisi sekolah saat ini: ${JSON.stringify(db.supervisions)}. Berikan jawaban ringkas, solutif, dan berbasis indikator resmi.`;

            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: text }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    })
                });

                const result = await response.json();
                const aiReply = result?.candidates?.[0]?.content?.parts?.[0]?.text || "Maaf, saya tidak dapat memproses tanggapan saat ini.";
                
                chatMessages.push({ role: 'assistant', text: aiReply });
            } catch (err) {
                chatMessages.push({ role: 'assistant', text: "Terjadi gangguan koneksi saat menghubungi Gemini AI API. Mohon periksa kembali jaringan Anda." });
            }

            renderAIAssistant(document.getElementById('content-area'));
        }

        function scrollChatToBottom() {
            const container = document.getElementById('chat-messages-container');
            if(container) container.scrollTop = container.scrollHeight;
        }
