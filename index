                    <button onclick="switchTeacherTab('tab-tindaklanjut')" class="teacher-tab-btn px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100" id="btn-tab-tindaklanjut">Tindak Lanjut (${teacherFollowUps.length})</button>
                    <button onclick="switchTeacherTab('tab-refleksi')" class="teacher-tab-btn px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100" id="btn-tab-refleksi">Refleksi (${teacherReflections.length})</button>
                </div>

                <!-- Tab Contents -->
                <div id="teacher-tab-content" class="space-y-4">
                    <!-- Default loaded tab content -->
                </div>
            `;

            // Default render Supervisi Tab
            renderTeacherSupervisionsTab(teacherSupervisions);
        }

        function switchTeacherTab(tabName) {
            document.querySelectorAll('.teacher-tab-btn').forEach(btn => {
                btn.className = "teacher-tab-btn px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100";
            });
            const activeBtn = document.getElementById(`btn-${tabName}`);
            if(activeBtn) activeBtn.className = "teacher-tab-btn active-tab px-4 py-2 rounded-lg text-brand-700 bg-brand-50 font-bold";

            const container = document.getElementById('teacher-tab-content');
            const db = getDB();

            if(tabName === 'tab-supervisi') {
                renderTeacherSupervisionsTab(db.supervisions);
            } else if(tabName === 'tab-rekomendasi') {
                container.innerHTML = `
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-3">
                        <h3 class="font-bold text-slate-800 text-sm">Rekomendasi AI & Supervisor</h3>
                        <p class="text-xs text-slate-500">Rekomendasi terarah berbasis indikator supervisi pembelajaran mendalam.</p>
                        <div class="space-y-3 pt-2">
                            ${db.supervisions.map(s => `
                                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                                    <div class="text-xs font-semibold text-brand-700">Supervisi Tgl ${s.date}</div>
                                    <p class="text-xs text-slate-700 mt-1">${s.analysisAI?.recommendation || 'Belum ada rekomendasi khusus.'}</p>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else if(tabName === 'tab-tindaklanjut') {
                container.innerHTML = `
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4">
                        <h3 class="font-bold text-slate-800 text-sm">Rencana Tindak Lanjut Guru</h3>
                        <div class="space-y-3">
                            ${db.followUps.map(f => `
                                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 flex justify-between items-start">
                                    <div>
                                        <div class="text-xs font-bold text-slate-800">${f.finding}</div>
                                        <div class="text-xs text-slate-500 mt-1">Rencana: ${f.actionPlan}</div>
                                        <div class="text-[11px] text-slate-400 mt-1">Target: ${f.targetDate} | PIC: ${f.pic}</div>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${f.status === 'SELESAI' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                                        ${f.status}
                                    </span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else if(tabName === 'tab-refleksi') {
                container.innerHTML = `
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4">
                        <h3 class="font-bold text-slate-800 text-sm">Catatan Refleksi Mandiri Guru</h3>
                        ${db.reflections.map(r => `
                            <div class="p-4 bg-blue-50/50 rounded-xl border border-blue-100 space-y-2 text-xs">
                                <div class="font-bold text-brand-800">Refleksi Tanggal: ${r.date}</div>
                                <p><strong>Berjalan Baik:</strong> ${r.good}</p>
                                <p><strong>Perlu Diperbaiki:</strong> ${r.needsImprovement}</p>
                                <p><strong>Dukungan Dibutuhkan:</strong> ${r.supportNeeded}</p>
                            </div>
                        `).join('')}
                    </div>
                `;
            }
        }

        function renderTeacherSupervisionsTab(supervisions) {
            const container = document.getElementById('teacher-tab-content');
            container.innerHTML = `
                <div class="bg-white rounded-2xl border border-slate-200 p-5">
                    <h3 class="text-sm font-bold text-slate-800 mb-3">Riwayat Supervisi Guru</h3>
                    <div class="space-y-3">
                        ${supervisions.map(s => `
                            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div>
                                    <div class="flex items-center space-x-2">
                                        <span class="font-bold text-sm text-slate-800">${s.date}</span>
                                        <span class="px-2 py-0.5 bg-brand-100 text-brand-800 text-[10px] font-bold rounded">${s.type}</span>
                                    </div>
                                    <div class="text-xs text-slate-500 mt-1">Supervisor: ${s.supervisorName}</div>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <div class="text-right">
                                        <div class="text-lg font-bold text-brand-700">${s.finalGrade}</div>
                                        <div class="text-[10px] font-semibold text-slate-500">${s.category}</div>
                                    </div>
                                    <button onclick="navigateTo('supervision-result', {supervisionId: '${s.id}'})" class="bg-brand-600 hover:bg-brand-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold">
                                        Lihat Hasil
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function startNewSupervisionForTeacher(teacherId) {
            navigateTo('supervision-form', { type: 'PELAKSANAAN', teacherId: teacherId });
        }
    </script>

    <script>
        let currentFormState = {
            teacherId: '',
            type: 'PELAKSANAAN',
            scores: {},
            notes: {},
            qualitative: {
                strengths: '',
                improvements: '',
                recommendations: '',
                evaluator: ''
            },
            aiAnalysis: {}
        };

        function startNewSupervision(type) {
            const db = getDB();
            const firstTeacher = db.users.find(u => u.role === 'GURU');
            navigateTo('supervision-form', { type: type, teacherId: firstTeacher ? firstTeacher.id : '' });
        }

        function renderSupervisionForm(container, type, teacherId) {
            const db = getDB();
            const teachers = db.users.filter(u => u.role === 'GURU');
            const selectedTeacher = teachers.find(t => t.id === teacherId) || teachers[0];

            currentFormState.teacherId = selectedTeacher ? selectedTeacher.id : '';
            currentFormState.type = type;
            currentFormState.scores = {};
            currentFormState.notes = {};

            container.innerHTML = `
                <!-- Form Navigation Header -->
                <div class="flex items-center justify-between bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div>
                        <span class="text-xs font-bold text-brand-600 uppercase tracking-wider block">Formulir Supervisi Baru</span>
                        <h1 class="text-lg font-bold text-slate-800">
                            ${type === 'PELAKSANAAN' ? '[1] SUPERVISI PELAKSANAAN PEMBELAJARAN MENDALAM' : '[2] TELAAH PERENCANAAN PEMBELAJARAN MENDALAM'}
                        </h1>
                    </div>
                    <button onclick="navigateTo('dashboard')" class="text-slate-400 hover:text-slate-600">
                        <i data-lucide="x-circle" class="w-6 h-6"></i>
                    </button>
                </div>

                <!-- Teacher Selector & Identity Info -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2">Identitas Supervisi</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Pilih Guru</label>
                            <select id="form-teacher-select" onchange="onFormTeacherChange(this.value, '${type}')" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500">
                                ${teachers.map(t => `<option value="${t.id}" ${t.id === selectedTeacher?.id ? 'selected' : ''}>${t.name} - ${t.mapel}</option>`).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Mata Pelajaran</label>
                            <input type="text" readonly value="${selectedTeacher?.mapel || ''}" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-600">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Nama Sekolah</label>
                            <input type="text" readonly value="${selectedTeacher?.unit || ''}" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-600">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Supervisi</label>
                            <input type="date" id="form-date" value="${new Date().toISOString().split('T')[0]}" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Petugas Supervisi</label>
                            <input type="text" id="form-supervisor" value="${db.users.find(u => u.role === 'SUPERVISOR')?.name || 'Supervisor'}" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs">
                        </div>
                    </div>
                </div>

                <!-- Document Upload & AI Document Analyzer Section -->
                <div class="bg-gradient-to-r from-slate-900 to-brand-900 text-white p-5 rounded-2xl shadow-md space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="p-2 bg-brand-500/20 text-brand-300 rounded-lg">
                                <i data-lucide="sparkles" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold">AI Document Analyzer (RPP / Modul Ajar)</h3>
                                <p class="text-xs text-slate-300">Upload Modul Ajar (PDF/DOCX) untuk ektraksi otomatis bukti & rekomendasi skor AI.</p>
                            </div>
                        </div>
                        <label class="bg-brand-600 hover:bg-brand-500 text-white px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer shadow transition flex items-center space-x-2">
                            <i data-lucide="upload" class="w-4 h-4"></i>
                            <span>UPLOAD RPP / MODUL AJAR</span>
                            <input type="file" accept=".pdf,.docx,.doc" onchange="handleDocumentUpload(event)" class="hidden">
                        </label>
                    </div>
                    <div id="ai-document-status" class="hidden p-3 bg-white/10 rounded-xl text-xs text-brand-200 flex items-center justify-between">
                        <span id="ai-status-text">Memproses dokumen...</span>
                        <i data-lucide="loader" class="w-4 h-4 animate-spin"></i>
                    </div>
                </div>

                <!-- Real-time Progress Bar -->
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm sticky top-16 z-20">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1">
                        <span>PROGRESS SUPERVISI</span>
                        <span id="progress-text">0 dari ${type === 'PELAKSANAAN' ? 40 : 15} Indikator Selesai (0%)</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                        <div id="progress-bar-fill" class="bg-brand-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Assessment Instrument Checklist Container -->
                <div class="space-y-6">
                    ${type === 'PELAKSANAAN' ? renderInstrument1Checklist() : renderInstrument2Checklist()}
                </div>

                <!-- Form Submit and Validation Action Footer -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-md flex justify-between items-center sticky bottom-4">
                    <button onclick="navigateTo('dashboard')" class="px-4 py-2 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-50">
                        Batal
                    </button>
                    <button onclick="submitSupervisionForm()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl text-xs font-bold shadow transition flex items-center space-x-2">
                        <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                        <span>Simpan & Selesaikan Supervisi</span>
                    </button>
                </div>
            `;

            lucide.createIcons();
        }

        function onFormTeacherChange(teacherId, type) {
            renderSupervisionForm(document.getElementById('content-area'), type, teacherId);
        }

        /* Render Instrument 1 Checklist (40 Indicators) */
        function renderInstrument1Checklist() {
            return INSTRUMENT_1_DATA.map(group => `
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                    <h3 class="text-xs font-bold text-brand-700 uppercase tracking-wider bg-brand-50 p-2.5 rounded-lg border border-brand-100">
                        ${group.section}
                    </h3>
                    <div class="space-y-4 divide-y divide-slate-100">
                        ${group.indicators.map(ind => `
                            <div class="pt-3 space-y-2">
                                <div class="flex items-start justify-between gap-4">
                                    <span class="text-xs font-medium text-slate-800 flex-1">
                                        <strong class="text-brand-600 font-bold">${ind.id}.</strong> ${ind.text}
                                    </span>
                                </div>

                                <!-- AI Card Placement (Injected dynamically if analyzed) -->
                                <div id="ai-card-inst1-${ind.id}" class="hidden"></div>

                                <!-- Radio Scale Options -->
                                <div class="flex flex-wrap items-center gap-4 pt-1">
                                    <label class="flex items-center space-x-2 cursor-pointer bg-slate-50 hover:bg-emerald-50 p-2 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 transition">
                                        <input type="radio" name="ind1_${ind.id}" value="1" onchange="updateScore1(${ind.id}, 1)" class="text-brand-600 focus:ring-brand-500">
                                        <span>Sesuai (1)</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer bg-slate-50 hover:bg-amber-50 p-2 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 transition">
                                        <input type="radio" name="ind1_${ind.id}" value="2" onchange="updateScore1(${ind.id}, 2)" class="text-brand-600 focus:ring-brand-500">
                                        <span>Sesuai Sebagian (2)</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer bg-slate-50 hover:bg-blue-50 p-2 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 transition">
                                        <input type="radio" name="ind1_${ind.id}" value="3" onchange="updateScore1(${ind.id}, 3)" class="text-brand-600 focus:ring-brand-500">
                                        <span>Sesuai Catatan (3)</span>
                                    </label>
                                </div>

                                <div>
                                    <input type="text" placeholder="Catatan Supervisor..." onchange="updateNote1(${ind.id}, this.value)" class="w-full text-xs p-2 border border-slate-200 rounded-lg focus:ring-1 focus:ring-brand-500">
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');
        }

        /* Render Instrument 2 Checklist (15 Indicators + Subindicators) */
        function renderInstrument2Checklist() {
            return INSTRUMENT_2_DATA.map(group => `
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                    <h3 class="text-xs font-bold text-brand-700 uppercase tracking-wider bg-brand-50 p-2.5 rounded-lg border border-brand-100">
                        ${group.section}
                    </h3>
                    <div class="space-y-4 divide-y divide-slate-100">
                        ${group.indicators.map(ind => `
                            <div class="pt-3 space-y-2">
                                <div class="text-xs font-medium text-slate-800">
                                    <strong class="text-brand-600 font-bold">${ind.id}.</strong> ${ind.text}
                                </div>

                                ${ind.subindicators ? `
                                    <div class="pl-4 py-2 bg-slate-50 rounded-lg text-[11px] text-slate-600 space-y-1 border border-slate-100">
                                        <div class="font-bold text-slate-500">Subindikator:</div>
                                        ${ind.subindicators.map(sub => `<div>${sub}</div>`).join('')}
                                    </div>
                                ` : ''}

                                <!-- AI Card Placement -->
                                <div id="ai-card-inst2-${ind.id}" class="hidden"></div>

                                <!-- 0 - 4 Scale Selection -->
                                <div class="flex items-center space-x-2 pt-1">
                                    <span class="text-xs font-bold text-slate-500">SKOR:</span>
                                    ${[0, 1, 2, 3, 4].map(score => `
                                        <label class="cursor-pointer bg-slate-50 hover:bg-brand-50 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 transition">
                                            <input type="radio" name="ind2_${ind.id}" value="${score}" onchange="updateScore2(${ind.id}, ${score})" class="mr-1"> ${score}
                                        </label>
                                    `).join('')}
                                </div>

                                <div>
                                    <textarea placeholder="Komentar Kritis Supervisor..." onchange="updateNote2(${ind.id}, this.value)" class="w-full text-xs p-2 border border-slate-200 rounded-lg h-16 focus:ring-1 focus:ring-brand-500"></textarea>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('') + `
                <!-- Instrument 2 Qualitative Section -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">BAGIAN KUALITATIF PERENCANAAN</h3>
                    
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">KELEBIHAN PERENCANAAN PEMBELAJARAN</label>
                        <textarea id="inst2-strengths" onchange="currentFormState.qualitative.strengths = this.value" class="w-full text-xs p-2.5 border border-slate-200 rounded-xl h-20 focus:ring-2 focus:ring-brand-500"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">HAL YANG PERLU DITINGKATKAN DARI PERENCANAAN PEMBELAJARAN</label>
                        <textarea id="inst2-improvements" onchange="currentFormState.qualitative.improvements = this.value" class="w-full text-xs p-2.5 border border-slate-200 rounded-xl h-20 focus:ring-2 focus:ring-brand-500"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">REKOMENDASI DAN REVISI PERENCANAAN PEMBELAJARAN SESUAI PRINSIP PEMBELAJARAN MENDALAM</label>
                        <textarea id="inst2-recom" onchange="currentFormState.qualitative.recommendations = this.value" class="w-full text-xs p-2.5 border border-slate-200 rounded-xl h-20 focus:ring-2 focus:ring-brand-500"></textarea>
                    </div>
                </div>
            `;
        }

        /* Update Form Progress & Scores */
        function updateScore1(indId, score) {
            currentFormState.scores[indId] = score;
            updateProgressBar(40);
        }

        function updateNote1(indId, note) {
            currentFormState.notes[indId] = note;
        }

        function updateScore2(indId, score) {
            currentFormState.scores[indId] = score;
            updateProgressBar(15);
        }

        function updateNote2(indId, note) {
            currentFormState.notes[indId] = note;
        }

        function updateProgressBar(totalCount) {
            const answered = Object.keys(currentFormState.scores).length;
            const pct = Math.round((answered / totalCount) * 100);
            
            document.getElementById('progress-text').textContent = `${answered} dari ${totalCount} Indikator Selesai (${pct}%)`;
            document.getElementById('progress-bar-fill').style.width = `${pct}%`;
        }

        /* Document Upload & AI Analysis Handler */
        function handleDocumentUpload(event) {
            const file = event.target.files[0];
            if(!file) return;

            const statusEl = document.getElementById('ai-document-status');
            const statusText = document.getElementById('ai-status-text');
            statusEl.classList.remove('hidden');
            statusText.textContent = `Membaca file "${file.name}" & menganalisis bukti dokumen...`;

            // Simulate AI Document Extraction Delay
            setTimeout(() => {
                statusText.textContent = `Analisis AI selesai! Bukti & rekomendasi skor telah ditambahkan pada indikator.`;
                
                // Inject AI Cards
                if(currentFormState.type === 'PELAKSANAAN') {
                    [1, 2, 4, 7, 23].forEach(id => {
                        injectAICardInst1(id);
                    });
                } else {
                    [1, 3, 7, 13].forEach(id => {
                        injectAICardInst2(id);
                    });
                }

                setTimeout(() => {
                    statusEl.classList.add('hidden');
                }, 4000);
            }, 2000);
        }

        function injectAICardInst1(id) {
            const container = document.getElementById(`ai-card-inst1-${id}`);
            if(!container) return;

            container.classList.remove('hidden');
            container.innerHTML = `
                <div class="my-2 p-3 bg-indigo-50/70 border border-indigo-200 rounded-xl space-y-1.5 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-indigo-900 flex items-center space-x-1">
                            <i data-lucide="bot" class="w-3.5 h-3.5 text-indigo-600"></i>
                            <span>ANALISIS AI DOKUMEN</span>
                        </span>
                        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded">✓ TERIDENTIFIKASI</span>
                    </div>
                    <div>
                        <strong class="text-indigo-950">BUKTI DARI DOKUMEN:</strong>
                        <p class="italic text-slate-700 bg-white p-2 rounded border border-indigo-100 mt-0.5">"Modul Ajar Halaman 3: Guru mengajukan pertanyaan 'Bagaimana sel merespons racun lingkungan?' pada kegiatan apersepsi."</p>
                    </div>
                    <div>
                        <strong class="text-indigo-950">ANALISIS AI:</strong>
                        <span class="text-slate-700">Pertanyaan pemantik telah mendorong penalaran kritis dan berkesadaran siswa.</span>
                    </div>
                    <div class="flex items-center space-x-2 pt-1 border-t border-indigo-100">
                        <span class="font-bold text-indigo-900">REKOMENDASI SKOR AI: <span class="text-emerald-700 font-extrabold">1 (Sesuai)</span></span>
                    </div>
                </div>
            `;
            lucide.createIcons();
        }

        function injectAICardInst2(id) {
            const container = document.getElementById(`ai-card-inst2-${id}`);
            if(!container) return;

            container.classList.remove('hidden');
            container.innerHTML = `
                <div class="my-2 p-3 bg-indigo-50/70 border border-indigo-200 rounded-xl space-y-1.5 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-indigo-900 flex items-center space-x-1">
                            <i data-lucide="bot" class="w-3.5 h-3.5 text-indigo-600"></i>
