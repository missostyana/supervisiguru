        /* Save & Submit Supervision */
        function submitSupervisionForm() {
            const db = getDB();
            const totalRequired = currentFormState.type === 'PELAKSANAAN' ? 40 : 15;
            const answeredCount = Object.keys(currentFormState.scores).length;

            if (answeredCount < totalRequired) {
                alert(`Peringatan: Anda baru mengisi ${answeredCount} dari ${totalRequired} indikator. Harap lengkapi semua indikator sebelum menyimpan.`);
                return;
            }

            // Calculation
            let totalScore = 0;
            Object.values(currentFormState.scores).forEach(s => totalScore += parseInt(s));

            let maxScore = currentFormState.type === 'PELAKSANAAN' ? 120 : 60;
            let finalGrade = Math.round((totalScore / maxScore) * 100);
            
            let category = 'Kurang';
            if (finalGrade >= 86) category = 'Amat Baik';
            else if (finalGrade >= 70) category = 'Baik';

            const selectedTeacher = db.users.find(u => u.id === currentFormState.teacherId);

            const newSupervision = {
                id: 'SUPV-' + Date.now(),
                teacherId: currentFormState.teacherId,
                teacherName: selectedTeacher ? selectedTeacher.name : 'Guru',
                mapel: selectedTeacher ? selectedTeacher.mapel : '',
                school: selectedTeacher ? selectedTeacher.unit : '',
                date: document.getElementById('form-date').value,
                supervisorName: document.getElementById('form-supervisor').value,
                type: currentFormState.type,
                totalScore: totalScore,
                maxScore: maxScore,
                finalGrade: finalGrade,
                category: category,
                status: 'Selesai',
                scores: currentFormState.scores,
                notes: currentFormState.notes,
                qualitative: currentFormState.qualitative,
                analysisAI: {
                    strengths: "Guru sangat menguasai pembelajaran mendalam dan pelibatan murid aktif.",
                    improvements: "Diperlukan penguatan media interaktif dan manajemen alokasi waktu penutup.",
