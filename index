        }

        function saveTeacherReflection() {
            const db = getDB();
            const newRefl = {
                id: 'RFL-' + Date.now(),
                teacherId: 'TCH-001',
                date: new Date().toISOString().split('T')[0],
                good: document.getElementById('refl-good').value,
                needsImprovement: document.getElementById('refl-improve').value,
                challenges: document.getElementById('refl-challenge').value,
                supportNeeded: document.getElementById('refl-support').value
            };

            db.reflections.unshift(newRefl);
            saveDB(db);
            alert("Refleksi mandiri berhasil disimpan!");
            navigateTo('dashboard');
        }
    </script>

