    <script>
        let currentRole = 'SUPERVISOR';
        let currentView = 'dashboard';

        function updateRoleButtons() {
            ['ADMIN', 'SUPERVISOR', 'GURU'].forEach(role => {
                const btn = document.getElementById(`role-btn-${role}`);
                if (btn) {
                    if (role === currentRole) {
                        btn.className = "px-2.5 py-1 rounded-md text-white bg-brand-600 font-semibold shadow-sm";
                    } else {
                        btn.className = "px-2.5 py-1 rounded-md text-slate-300 hover:text-white transition";
                    }
                }
            });

            // Update user profile header
            const db = getDB();
            let matchedUser = db.users.find(u => u.role === currentRole) || db.users[0];
            document.getElementById('header-user-name').textContent = matchedUser.name;
            document.getElementById('header-user-role').textContent = matchedUser.role;
            if(matchedUser.photo) {
                document.getElementById('header-user-photo').src = matchedUser.photo;
            }
        }

        function switchRole(role) {
            currentRole = role;
            updateRoleButtons();
            navigateTo('dashboard');
        }

        function navigateTo(viewName, params = {}) {
            currentView = viewName;
            
            // Highlight nav
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('bg-brand-50', 'text-brand-700', 'font-semibold');
            });
            const activeNav = document.getElementById(`nav-${viewName}`);
            if(activeNav) {
                activeNav.classList.add('bg-brand-50', 'text-brand-700', 'font-semibold');
            }

            const container = document.getElementById('content-area');
            
            switch (viewName) {
                case 'dashboard':
                    renderDashboard(container);
                    break;
                case 'teachers':
                    renderTeachersList(container);
                    break;
                case 'teacher-detail':
                    renderTeacherDetail(container, params.teacherId);
                    break;
                case 'supervision-form':
                    renderSupervisionForm(container, params.type, params.teacherId);
                    break;
                case 'fast-supervision':
                    renderFastSupervision(container);
                    break;
                case 'history':
                    renderSupervisionHistory(container);
                    break;
                case 'supervision-result':
                    renderSupervisionResult(container, params.supervisionId);
                    break;
                case 'followup':
                    renderFollowUpPage(container);
                    break;
                case 'reflection':
                    renderReflectionPage(container);
                    break;
                case 'ai-assistant':
                    renderAIAssistant(container);
                    break;
                default:
                    renderDashboard(container);
            }
            
            lucide.createIcons();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>

