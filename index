                        <textarea id="refl-challenge" class="w-full text-xs p-2.5 border rounded-xl h-16"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Dukungan apa yang dibutuhkan dari Sekolah/Supervisor?</label>
                        <textarea id="refl-support" class="w-full text-xs p-2.5 border rounded-xl h-16"></textarea>
