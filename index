                    recommendation: "Meningkatkan pemanfaatan teknologi interaktif berbasis PhET/BioMan.",
                    followUp: "Mengikuti pelatihan pembuatan media visual interaktif."
                }
            };

            db.supervisions.unshift(newSupervision);
